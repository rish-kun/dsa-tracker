# Supabase Transaction pooler URI from Dashboard → Connect. Use the shared
# pooler hostname and port 6543 for both local runtime and Vercel serverless:
# postgres://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres
# The project-specific variable name prevents an unrelated shell DATABASE_URL
# from silently taking precedence.
DSA_TRACKER_DATABASE_URL=

# Clerk application credentials (Dashboard -> API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-only secret protecting POST /api/catalog/refresh.
CATALOG_REFRESH_SECRET=

# Temporary migration compatibility. Set the exact production Clerk user ID
# created for f20240606@pilani.bits-pilani.ac.in, then remove both values after
# the extension is connected with a Clerk API key.
LEGACY_OWNER_USER_ID=
ALLOW_UNAUTHENTICATED_API=false
